# Client
VITE_AUTH_URL=http://127.0.0.1:3001

# Auth server
AUTH_PORT=3001
CLIENT_ORIGIN=http://127.0.0.1:5173
GAME_INTERNAL_URL=http://127.0.0.1:3002
GAME_PUBLIC_WS_URL=ws://127.0.0.1:3002/v2/game
SESSION_TTL_SECONDS=86400
# Runtime persistence root. Auth uses SQLite; the game uses an atomic JSON file.
DATA_DIRECTORY=data
# Optional override; defaults to DATA_DIRECTORY/auth.sqlite.
# AUTH_DATABASE_PATH=data/auth.sqlite
# Optional override; defaults to DATA_DIRECTORY/game.json.
# GAME_DATA_PATH=data/game.json

# Game server
GAME_PORT=3002
# Browser-facing map package hosted by the client/static CDN. A future game
# version can select another package simply by declaring a different URL.
WORLD_PUBLIC_URL=http://127.0.0.1:5173/world
# Local authoritative copy used to initialize and simulate the game. It is not
# exposed by the game server.
WORLD_DIRECTORY=public/world
TICKET_SECRET=replace-with-the-same-long-random-value-on-both-servers
INTERNAL_SERVICE_SECRET=replace-with-a-different-long-random-value-on-both-servers
# Disabled unless an approved QA deployment explicitly enables DimaTest1's
# separately signed account entitlement. When enabled, a password is mandatory
# and is verified only by the game server (never committed to source/client code).
IRONFRONTS_DEBUG_CONTROLS_ENABLED=false
# IRONFRONTS_DEBUG_PASSWORD=choose-a-long-random-password
